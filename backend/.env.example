PORT=4000
NODE_ENV=development
DATABASE_FILE=./data/finpay.sqlite
# Comma-separated list of allowed browser origins (only needed if the frontend calls the API directly, not through the Vite proxy)
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Match TalentHub's existing JWT verification configuration. Never use a new secret in production.
JWT_SECRET=local-demo-secret-change-me-please-32chars
JWT_ISSUER=talenthub
JWT_AUDIENCE=finpay
# Local demonstration only. Keep false outside local development.
ENABLE_DEV_AUTH=true
# Seed 3 demo students with ~45 days of realistic history on first run
SEED_DEMO_DATA=true
